# ==============================================================================
# AI E2E Agent Configuration
# ==============================================================================
# Copy this file to .env and update with your values

# ------------------------------------------------------------------------------
# Required Configuration
# ------------------------------------------------------------------------------

# Base URL for all tests
# This is the starting point for all your test executions
BASE_URL=https://example.com

# LLM Provider Configuration
# Choose 'openai', 'anthropic', or 'mistral'
LLM_PROVIDER=openai

# API Keys (at least one is required - set the one matching your provider)
OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# MISTRAL_API_KEY=your-mistral-key-here

# ------------------------------------------------------------------------------
# Directory Configuration (all optional - defaults shown)
# ------------------------------------------------------------------------------

# Directory containing test markdown files
# TESTS_DIR=tests

# Directory for generated Playwright test specs
# GENERATED_TESTS_DIR=./src/tests

# Directory for test reports (HTML, JSON)
# REPORTS_DIR=test-reports

# Directory for debug screenshots
# DEBUG_SCREENSHOTS_DIR=debug-screenshots

# Directory for Playwright HTML reports
# PLAYWRIGHT_REPORT_DIR=test-reports/playwright-report

# ------------------------------------------------------------------------------
# Test Execution Configuration (all optional)
# ------------------------------------------------------------------------------

# Default maximum steps for tests (can be overridden per test)
# DEFAULT_MAX_STEPS=30

# Auto dismiss cookie banners (true/false)
# AUTO_DISMISS_COOKIES=true

# Enable debug mode by default (true/false)
# DEBUG_MODE=false

# Run browser in headless mode (true/false)
# Set to false to see the browser during test execution
# HEADLESS=false

# Browser timeout in milliseconds
# BROWSER_TIMEOUT=30000

# Delay between test steps in milliseconds
# STEP_DELAY=500

# ------------------------------------------------------------------------------
# LLM Configuration (optional)
# ------------------------------------------------------------------------------

# Model configuration
# LLM_MODEL=gpt-4o-mini                    # For OpenAI (default)
# LLM_MODEL=claude-3-5-sonnet-20241022     # For Anthropic (default)
# LLM_MODEL=mistral-large-latest           # For Mistral (default)

# LLM parameters
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=1000
